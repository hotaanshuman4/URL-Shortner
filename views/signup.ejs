<!DOCTYPE html>
<html lang="en">    
    <head>
        <style>
        body{
            font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        </style>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Sign Up</title>
    </head>
    <body>
        <h1>Sign Up</h1>
        <form action="/user" method="post">
            <label>Full Name</label>
            <input type="text" required name="name" placeholder="Anshu Boss"/>
            <label>Email</label>
            <input type="email" required name="email" placeholder="anshu.boss@example.com"/>
            <label>Password</label>
            <input type="password" required name="password" placeholder="Enter your password"/>
            <button type="submit">Sign Up</button>
        </form>
    </body>
</html>